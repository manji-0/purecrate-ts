{
  "name": "payment",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=21" },
  "exports": {
    ".": {
      "purecrate-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wire": {
      "purecrate-source": "./src/purecrate-wire.ts",
      "types": "./dist/purecrate-wire.d.ts",
      "default": "./dist/purecrate-wire.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^6.0.0 || ^7.0.0"
  }
}
