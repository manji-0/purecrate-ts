{
  // The lint every example's generated output passes (scripts/verify.sh, with
  // --type-aware), the wire module included. The copied runtime and adapters
  // are hand-written and not linted here.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "eslint", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    // A brand is a cast by design; crates/cli/tests/it/casts.rs admits each
    // kind of cast the output makes (design/03-output.md §1.1).
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "eslint/no-else-return": "error",
    "eslint/no-lonely-if": "error",
    "eslint/no-lone-blocks": "error",
    "eslint/no-useless-rename": "error",
    "unicorn/empty-brace-spaces": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/purecrate-runtime.ts",
    "**/purecrate-zod.ts",
    "**/purecrate-valibot.ts",
    "**/purecrate-arktype.ts"
  ]
}
